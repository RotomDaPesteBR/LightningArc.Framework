<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IsPackable>false</IsPackable>
    <RootNamespace>LightningArc.Analyzers</RootNamespace>
    <AssemblyName>LightningArc.Analyzers</AssemblyName>
  </PropertyGroup>

  <PropertyGroup>
    <NoWarn>$(NoWarn);RS1038;CS1591</NoWarn>
    <PackageTags>lightningarc dotnet clean-code roslyn-analyzers static-analysis code-quality</PackageTags>
    <Description>Roslyn static analyzers and code fixes to enforce LightningArc best practices and prevent common errors.</Description>
  </PropertyGroup>

  <ItemGroup>
    <AdditionalFiles Include="Analyzers\AnalyzerReleases.Shipped.md" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" />
  </ItemGroup>

</Project>
