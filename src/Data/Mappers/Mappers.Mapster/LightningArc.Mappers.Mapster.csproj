<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net6.0;net9.0;net10.0</TargetFrameworks>
    <SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>

    <RootNamespace>LightningArc.Mappers.Mapster</RootNamespace>

    <NoWarn>$(NoWarn);IDE0130</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <AssemblyName>LightningArc.Mappers.Mapster</AssemblyName>
    <PackageTags>lightningarc dotnet clean-code repository-pattern mapster</PackageTags>
    <Description>Mapster adapter for the LightningArc data layer.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Mapster" />
    <PackageReference Include="Mapster.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Data.Abstractions\LightningArc.Data.Abstractions.csproj" />
  </ItemGroup>

</Project>





