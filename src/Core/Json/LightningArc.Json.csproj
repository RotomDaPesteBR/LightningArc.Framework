<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>netstandard2.0;net9.0;net10.0</TargetFrameworks>
        <RootNamespace>LightningArc.Json</RootNamespace>
        <NoWarn>$(NoWarn);IDE0130</NoWarn>
    </PropertyGroup>
    <PropertyGroup>
        <AssemblyName>LightningArc.Json</AssemblyName>
        <PackageTags>lightningarc dotnet clean-code serialization system-text-json</PackageTags>
        <Description>System.Text.Json converters and serialization helpers for LightningArc types and Value Objects.</Description>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="..\Primitives\LightningArc.Primitives.csproj" />
    </ItemGroup>
    <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
        <PackageReference Include="PolySharp" PrivateAssets="All" />
        <PackageReference Include="System.Text.Json" />
    </ItemGroup>
</Project>
