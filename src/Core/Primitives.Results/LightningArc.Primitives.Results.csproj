<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	<TargetFrameworks>netstandard2.0;net9.0;net10.0</TargetFrameworks>

	<RootNamespace>LightningArc.Primitives</RootNamespace>

	<NoWarn>$(NoWarn);IDE0130</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
	<AssemblyName>LightningArc.Primitives.Results</AssemblyName>
	<PackageTags>lightningarc dotnet clean-code value-objects domain-driven-design validation email cpf cnpj</PackageTags>
	<Description>Functional extensions that integrate LightningArc Primitives with the Result pattern for fluent validation.</Description>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
	<PackageReference Include="PolySharp" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
	<ProjectReference Include="..\Primitives\LightningArc.Primitives.csproj" />
	<ProjectReference Include="..\Results\LightningArc.Results.csproj" />
  </ItemGroup>
</Project>
