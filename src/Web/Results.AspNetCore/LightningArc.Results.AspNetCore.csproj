<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net6.0;net9.0;net10.0</TargetFrameworks>
    <OutputType>Library</OutputType>
    <RootNamespace>LightningArc.Results.AspNetCore</RootNamespace>
    <NoWarn>$(NoWarn);IDE0130</NoWarn>
  </PropertyGroup>
  <PropertyGroup>
    <AssemblyName>LightningArc.Results.AspNetCore</AssemblyName>
    <PackageTags>lightningarc dotnet clean-code aspnetcore api middleware problem-details result-pattern</PackageTags>
    <Description>Metapackage bundle containing LightningArc ASP.NET Core integrations.</Description>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net6.0'">
    <PackageReference Include="PolySharp" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Core\Results\LightningArc.Results.csproj" />
  </ItemGroup>
</Project>

